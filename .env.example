# GEMINI_API_KEY: Chave da API do Gemini para as funcionalidades de IA.
# Você pega esta chave no Google AI Studio (Settings > API Keys).
GEMINI_API_KEY="SUA_CHAVE_GEMINI"

# VARIÁVEIS DO FIREBASE (VITE_):
# Copie esses valores do seu arquivo firebase-applet-config.json
# ou do console do Firebase (Configurações do Projeto > Seus Aplicativos).
VITE_FIREBASE_API_KEY="SUA_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="SEU_PROJETO.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="SEU_PROJETO_ID"
VITE_FIREBASE_STORAGE_BUCKET="SEU_PROJETO.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="SEU_ID"
VITE_FIREBASE_APP_ID="SEU_APP_ID"

# HOTMART_TOKEN: Usado apenas no servidor (server.ts) para o Webhook.
HOTMART_TOKEN="TOKEN_DA_HOTMART"

# WIAPY_TOKEN: Usado no servidor (server.ts) para validar o Webhook da WIAPY.
WIAPY_TOKEN="TOKEN_DA_WIAPY"

# WIAPY_PRODUCT_ID: ID do produto na WIAPY (visível no painel).
# Use como alternativa caso não encontre o token.
WIAPY_PRODUCT_ID="69fc9275c2ab2347ebe0198c"

# FIREBASE_SERVICE_ACCOUNT: JSON da conta de serviço (em base64 ou string).
# Necessário para gerar tokens de acesso por e-mail.
# Pegue em: Projeto > Configurações > Contas de Serviço > Gerar nova chave privada.
FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", ...}'
