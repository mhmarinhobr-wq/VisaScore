rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    function isOwner(email) {
      return isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email.lower();
    }

    // Admins
    match /admins/{email} {
      allow get: if isSignedIn() && (isOwner(email) || isAdmin());
      allow list: if isAdmin();
      allow create: if (isOwner(email) && email.lower() == 'mhmarinhobr@gmail.com') || isAdmin();
      allow delete: if isAdmin() && email.lower() != 'mhmarinhobr@gmail.com';
    }

    // Users
    match /users/{email} {
      allow get: if isOwner(email) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(email) && request.resource.data.status in ['active', 'pending'];
      allow update: if isAdmin() || (isOwner(email) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAccess', 'status', 'displayName', 'photoURL', 'email', 'updatedAt', 'uid']));
      allow delete: if isAdmin();
    }

    // Whitelists
    match /whitelists/{email} {
      allow get: if isSignedIn() && request.auth.token.email.lower() == email.lower();
      allow list, write: if isAdmin();
    }

    // Settings
    match /settings/content {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
